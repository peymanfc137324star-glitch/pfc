{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pfc",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "73d11ad1-3fcb-472a-a9c8-94b1b1aad1d3","database_name": "pfc" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "dc7d8d48c023484697cf7254f0d3f7da" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
